# Copy to .env.local for local runs, or set these in the hosting platform's environment variables.
# Never commit a filled-in copy: .env* files are git-ignored.

# Public address of the site, used for canonical links, share previews, the sitemap and robots.txt.
# Leave unset locally; on Vercel the production domain is used automatically.
SITE_URL=

# Where /api/enquiry forwards contact-form enquiries (an email or form service's webhook).
# Without it, every enquiry shows "Not sent" with an option to copy it instead.
ENQUIRY_WEBHOOK_URL=
